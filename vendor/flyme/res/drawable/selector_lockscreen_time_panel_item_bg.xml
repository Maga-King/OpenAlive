<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2.0dp" android:color="?colorPrimary" />
                    <corners android:radius="@dimen/editor_panel_time_panel_inner_corner_radius" />
                </shape>
            </item>
            <item android:left="4.0dp" android:top="4.0dp" android:right="4.0dp" android:bottom="4.0dp">
                <shape android:shape="rectangle">
                    <solid android:color="?colorSurfaceContainer" />
                    <corners android:radius="?cornerRegular" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2.0dp" android:color="?colorSurfaceContainer" />
                    <corners android:radius="@dimen/editor_panel_time_panel_inner_corner_radius" />
                </shape>
            </item>
            <item android:left="4.0dp" android:top="4.0dp" android:right="4.0dp" android:bottom="4.0dp">
                <shape android:shape="rectangle">
                    <solid android:color="?colorSurfaceContainer" />
                    <corners android:radius="?cornerRegular" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
